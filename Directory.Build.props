<Project>

    <ItemGroup Condition="'$(MSBuildProjectName)' != 'Shared'">
        <Content Include="$(MSBuildThisFileDirectory)settings\appsettings.json">
            <Link>appsettings.json</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

</Project>

